{
    "name": "pd3-mod-manager",
    "version": "0.2.3",
    "main": "out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "dist": "electron-vite build && electron-builder --publish never",
        "dist:win": "electron-vite build && electron-builder --win --publish never",
        "dist:linux": "electron-vite build && electron-builder --linux --publish never",
        "preview": "electron-vite preview",
        "typecheck": "tsc --noEmit",
        "prepare": "husky",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ShulhaOleh/pd3-mod-manager.git"
    },
    "keywords": [
        "pd3",
        "payday3",
        "mod-manager"
    ],
    "author": "Oleh Shulha",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/ShulhaOleh/pd3-mod-manager/issues"
    },
    "homepage": "https://github.com/ShulhaOleh/pd3-mod-manager#readme",
    "description": "A desktop mod manager for PAYDAY 3 powered by modworkshop",
    "devDependencies": {
        "@commitlint/cli": "^21.0.1",
        "@commitlint/config-conventional": "^21.0.1",
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "@tailwindcss/vite": "^4.3.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^25.7.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.2.0",
        "better-sqlite3": "^12.10.0",
        "electron": "^39.2.7",
        "electron-builder": "^26.8.1",
        "electron-vite": "^5.0.0",
        "husky": "^9.1.7",
        "prettier": "^3.8.3",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "vite": "^6.4.2",
        "vitest": "^4.1.6"
    },
    "dependencies": {
        "electron-updater": "^6.8.3",
        "lucide-react": "^1.16.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-markdown": "^10.1.0"
    }
}
