{
    "name": "pd3-mod-manager",
    "version": "0.7.1",
    "packageManager": "pnpm@10.32.1",
    "main": "out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "dist": "electron-vite build && electron-builder --publish never",
        "dist:win": "electron-vite build && electron-builder --win --publish never",
        "dist:linux": "electron-vite build && electron-builder --linux --publish never",
        "preview": "electron-vite preview",
        "typecheck": "tsc --noEmit",
        "prepare": "husky",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/modrexio/modrex.git"
    },
    "keywords": [
        "pd3",
        "payday3",
        "mod-manager"
    ],
    "author": "Oleh Shulha",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/modrexio/modrex/issues"
    },
    "homepage": "https://github.com/modrexio/modrex#readme",
    "description": "A desktop mod manager for PAYDAY 3 powered by modworkshop",
    "devDependencies": {
        "@commitlint/cli": "^21.0.1",
        "@commitlint/config-conventional": "^21.0.1",
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "@tailwindcss/vite": "^4.3.0",
        "@types/node": "^25.7.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/sql.js": "^1.4.11",
        "@vitejs/plugin-react": "^5.2.0",
        "electron": "^39.2.7",
        "electron-builder": "^26.8.1",
        "electron-vite": "^5.0.0",
        "husky": "^9.1.7",
        "prettier": "^3.8.3",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "vite": "^6.4.2",
        "vitest": "^4.1.6"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "electron",
            "esbuild",
            "electron-winstaller"
        ]
    },
    "dependencies": {
        "electron-log": "^5.4.4",
        "electron-updater": "^6.8.3",
        "highlight.js": "^11.11.1",
        "lucide-react": "^1.16.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-markdown": "^10.1.0",
        "rehype-highlight": "^7.0.2",
        "rehype-raw": "^7.0.0",
        "remark-breaks": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "sql.js": "^1.14.1"
    }
}
