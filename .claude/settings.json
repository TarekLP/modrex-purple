{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/hooks/format.mjs",
                        "timeout": 30
                    },
                    {
                        "type": "command",
                        "command": "node .claude/hooks/check-commands.mjs",
                        "timeout": 60
                    }
                ]
            }
        ]
    }
}
