---
import { GAMES, type ModTargetId } from '@modrex/games'
import { getDocsGame, type DocsGameId } from '../../data/docsGames'

interface Props {
    game: DocsGameId
}

const game = getDocsGame(Astro.props.game)
const targetPath = (targetId: ModTargetId) =>
    GAMES[game.id].modTargets.find((target) => target.id === targetId)!.path
---

<table class="docs-data-table">
    <thead>
        <tr>
            <th>Target</th>
            <th>Path under game folder</th>
            <th>Notes</th>
        </tr>
    </thead>
    <tbody>
        {
            game.targets.map((target) => (
                <tr>
                    <td>{target.label}</td>
                    <td>
                        {target.pathIsCode === false ? (
                            target.path
                        ) : (
                            <code>
                                {target.targetId ? targetPath(target.targetId) : target.path}
                            </code>
                        )}
                    </td>
                    <td>{target.notes}</td>
                </tr>
            ))
        }
    </tbody>
</table>
